{
  "manifest_version": 3,
  "name": "ZooHR — HR Spreadsheet Workspace",
  "version": "0.1.0",
  "description": "Local-first HR data extraction and analysis from Google Sheets.",
  "action": {
    "default_title": "Open ZooHR",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "identity"],
  "host_permissions": ["https://sheets.googleapis.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {}
}
