
{
  "manifest_version": 3,
  "name": "ZooHR — HR Spreadsheet Workspace",
  "version": "0.1.0",
  "description": "Local-first HR data extraction and analysis from Google Sheets.",
  "action": {
    "default_title": "Open ZooHR",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://sheets.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "oauth2": {
    "client_id": "840997357666-rqeo4o0ukf153hu0m5tdsifn0u06r805.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets.readonly"
    ]
  },
  "icons": {}
}
